# ------------------------------------------------------------------
# Turso (libSQL) — 予想・結果の永続化に使用
#   ローカルでは未設定でも動作します（seedデータからその場で予想を計算）。
#   本番の定期パイプライン（cron）を動かす場合のみ必要です。
# ------------------------------------------------------------------
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ローカル開発でファイルDBを使いたい場合（任意）
# TURSO_DATABASE_URL=file:local.db

# ------------------------------------------------------------------
# Vercel Cron を保護するためのシークレット
#   /api/cron/* は Authorization: Bearer $CRON_SECRET を要求します。
# ------------------------------------------------------------------
CRON_SECRET=change-me

# ------------------------------------------------------------------
# 実データ接続
#   DATA_SOURCE=thesportsdb で /api/cron/teams が実データを取得しDBへ保存。
#   未設定/seed の場合はサンプルデータで動作。
# ------------------------------------------------------------------
DATA_SOURCE=seed
# DATA_SOURCE=thesportsdb

# TheSportsDB（無料。既定の "3" はテストキー。実運用は自分のキー推奨）
THESPORTSDB_KEY=3
THESPORTSDB_LEAGUE=Japanese J1 League
# 取得シーズン（カンマ区切り。未設定なら直近2年を自動）
# THESPORTSDB_SEASONS=2025,2024

# ------------------------------------------------------------------
# ニュース収集
#   NEWS_SOURCE=feeds で /api/cron/news がフィードを収集し特徴量化してDB保存。
#   未設定/seed の場合はサンプルのNewsFactorを使用。
# ------------------------------------------------------------------
NEWS_SOURCE=seed
# NEWS_SOURCE=feeds

# 収集元フィード（カンマ区切り。未設定ならGoogle NewsのJリーグ検索を使用）
# NEWS_FEEDS=https://news.google.com/rss/search?q=Jリーグ&hl=ja&gl=JP&ceid=JP:ja
# 取り込む記事の対象期間（日）
NEWS_MAX_AGE_DAYS=7

# LLMでの特徴量化（ANTHROPIC_API_KEYがある場合に自動使用。無効化は NEWS_USE_LLM=0）
# NEWS_USE_LLM=1
NEWS_LLM_MODEL=claude-opus-5

# ------------------------------------------------------------------
# ニュース要約に使うLLM（ANTHROPIC_API_KEYがあればニュース収集がLLM抽出を使用）
# ------------------------------------------------------------------
ANTHROPIC_API_KEY=
